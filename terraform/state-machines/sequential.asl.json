{
  "Comment": "Sequential execution pattern",
  "StartAt": "Basic",
  "States": {
    "Basic": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${basic_arn}",
        "Payload.$": "$"
      },
      "OutputPath": "$.Payload",
      "Next": "CpuBound"
    },
    "CpuBound": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${cpu_bound_arn}",
        "Payload.$": "$"
      },
      "OutputPath": "$.Payload",
      "Next": "IoBound"
    },
    "IoBound": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${io_bound_arn}",
        "Payload.$": "$"
      },
      "OutputPath": "$.Payload",
      "End": true
    }
  }
}